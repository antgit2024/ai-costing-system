[Unit]
Description=Jackyun nightly shipment incremental sync (auto-sync-backlog)
Documentation=file:///home/admin/ai-costing-system/DOC/agents/known_issues.md
After=planner-costing.service network.target
# Don't fail loudly if backend is restarting at trigger time — sync_jobs uses
# its own DB session and doesn't need the API to be up.

[Service]
Type=oneshot
WorkingDirectory=/home/admin/ai-costing-system/backend
EnvironmentFile=/home/admin/ai-costing-system/.env
ExecStart=/home/admin/ai-costing-system/backend/.venv/bin/python scripts/cron_sync_jackyun.py
StandardOutput=journal
StandardError=journal
# Hard ceiling — the upstream API is paginated; even a backlog of weeks
# should finish well under 30 min. If we hit this, something is wrong
# (likely Jackyun rate-limiting us) and the next nightly run will retry.
TimeoutStartSec=1800

[Install]
# Wanted by the timer, not by default.target — we don't run on boot.
WantedBy=default.target
