# Core database / API
PLANNER_DATABASE_URL=sqlite:///./planner.db
PLANNER_API_PREFIX=/api
PLANNER_IMPORT_CHUNK_SIZE=500

# Executor integration
EXECUTOR_BASE_URL=https://executor.example.com
EXECUTOR_API_KEY=
EXECUTOR_CALLBACK_URL=https://planner.example.com/api/planner/executor/callback
EXECUTOR_CALLBACK_SECRET=change-me-in-prod

# AI Benchmark provider
BENCHMARK_API_BASE_URL=https://benchmark.example.com
BENCHMARK_API_KEY=
BENCHMARK_CACHE_TTL_SECONDS=300

# Message bus / notifications
MESSAGE_BUS_BROKER=kafka1:9092
MESSAGE_BUS_TOPIC=planner.events

# Observability / feature flags
PLANNER_METRICS_ENABLED=true
PLANNER_FEATURE_FLAG_MOCK_INTEGRATIONS=false
PLANNER_REDIS_URL=redis://localhost:6379/0

# Optional: toggle mocks quickly during rollback
# PLANNER_FEATURE_FLAG_MOCK_INTEGRATIONS=true

# ===== Staff Auth · COSTING-C1 (2026-05) =====
# 服务账号回退通道 · POD→ai-costing 算价 / executor 等服务间调用走这把 key。
# prod 必配 · 32 位以上随机串。dev 留空也行 · require_admin_key 会放行。
PLANNER_ADMIN_KEY=

# 与 POD 平台共享的 staff JWT 解码密钥(POD 是唯一 IdP · ai-costing 只验不发)。
# 必须与 pod-design-platform/.env 同名值完全一致 · 改一边必须同步另一边。
POD_JWT_SECRET_KEY=dev-secret-change-in-production
POD_JWT_ALGORITHM=HS256

# 登录代理转发到 POD 后端的 base url + path。
# /admin/auth/login 会 POST {url}{path} 透传请求 · 不存任何明文密码。
POD_LOGIN_PROXY_URL=http://localhost:8180
POD_LOGIN_PATH=/api/pod/admin/staff/login

# ===== 吉客云 Open API (商家自研应用) =====
# AppKey / AppSecret 仅放环境变量,严禁入库或入仓库。
# 申请地址: https://open.jackyun.com  → 应用管理 → 创建应用(场景:其他)。
JACKYUN_API_BASE_URL=https://openapi.jackyun.com/openapi/router
JACKYUN_APP_KEY=
JACKYUN_APP_SECRET=
JACKYUN_API_VERSION=v1.0
JACKYUN_TIMEOUT_SECONDS=15
JACKYUN_MAX_RETRIES=2
JACKYUN_DEFAULT_PAGE_SIZE=50
