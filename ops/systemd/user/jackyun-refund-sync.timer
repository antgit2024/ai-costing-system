[Unit]
Description=Trigger jackyun-refund-sync.service nightly at 03:00 Asia/Shanghai

[Timer]
# 03:00 every night — 30 min after shipment sync (02:30) so the refund
# mapper's shipment_lines join finds freshly-imported orders.
# Server timezone is Asia/Shanghai (verified 2026-05-07).
OnCalendar=*-*-* 03:00:00
# If the host was off at trigger time, run as soon as it comes back up.
Persistent=true
# Avoid all timers firing simultaneously after a long downtime.
RandomizedDelaySec=120
Unit=jackyun-refund-sync.service

[Install]
WantedBy=timers.target
