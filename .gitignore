# Local virtual environments (do not delete actual folders, just ignore)
backend/.venv/
backend/venv/

# Python cache files that often appear alongside venv artifacts
**/*.pyc
**/__pycache__/

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml

# Local databases / runtime artifacts (never commit)
**/*.db
**/*.sqlite
**/*.sqlite3

# Local media / persisted downloads (never commit)
backend/media/

# Local logs / previews (never commit)
backend/logs/

# Local IDE/editor settings
.vscode/

# Environment files (keep templates in Git: `.env.sample`, `*.example`)
.env
frontend/.env.production

# Frontend dependencies & build artifacts
frontend/node_modules/
frontend/dist/

# Local oversized/raw spreadsheets (do not commit by default; keep fixtures/chunks tracked)
DOC/基础表单/绮妙1-10平台商品列表.xlsx
DOC/基础表单/ERP品商品下载原始列表.xlsx
