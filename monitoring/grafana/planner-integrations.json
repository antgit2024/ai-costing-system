{
  "title": "Planner Integrations",
  "style": "dark",
  "panels": [
    {
      "type": "stat",
      "title": "Executor Success",
      "targets": [
        {
          "expr": "sum(increase(planner_executor_requests_total{status='success'}[5m]))"
        }
      ],
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "stat",
      "title": "Executor Failure",
      "targets": [
        {
          "expr": "sum(increase(planner_executor_requests_total{status!='success'}[5m]))"
        }
      ],
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}
    },
    {
      "type": "graph",
      "title": "Benchmark Latency",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(planner_external_call_duration_seconds_bucket{integration='benchmark'}[5m])) by (le))"
        }
      ],
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 6}
    },
    {
      "type": "stat",
      "title": "Bus Events (5m)",
      "targets": [
        {
          "expr": "sum(increase(planner_message_bus_events_total[5m]))"
        }
      ],
      "gridPos": {"x": 0, "y": 10, "w": 12, "h": 4}
    }
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  }
}
